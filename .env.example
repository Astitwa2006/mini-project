# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Gemini LLM ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.5-flash-lite has the most generous free-tier daily quota of the
# currently-supported models (~1,000 requests/day vs. ~20-250 for others),
# which matters a lot given batchGenerateQuestions already folds several
# articles into each call. Do NOT use gemini-1.5-flash — it's fully retired
# and calls to it fail outright. Check https://ai.google.dev/gemini-api/docs/deprecations
# before picking a different model, and enable Cloud Billing on your
# Google AI Studio project (Tier 1) if you outgrow the free tier — a
# personal Google One/Gemini subscription does NOT raise API quotas, only
# AI Studio's own playground usage.
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Server ────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Question Pipeline ─────────────────────────────────────
# How long (in minutes) a generated question pool for a given topic combo
# stays cached before the next room requesting it triggers a fresh RSS+LLM
# run. Pools are generated lazily per-room (when a room is created), NOT on
# a recurring schedule — so this is a "how fresh" knob, not a "how often to
# regenerate everything" knob. News doesn't move fast enough to need
# sub-hour refreshes for a quiz game, and a shorter value here just spends
# more LLM quota regenerating pools nobody may be using.
RSS_REFRESH_INTERVAL_MINUTES=60
# Default questions per game (host can override)
DEFAULT_QUESTIONS_PER_GAME=10
# Max questions per game
MAX_QUESTIONS_PER_GAME=20
# Seconds per question
QUESTION_TIME_LIMIT_SECONDS=30

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Gemini LLM ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── Server ────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Question Pipeline ─────────────────────────────────────
# Minutes between RSS refresh cycles
RSS_REFRESH_INTERVAL_MINUTES=15
# Default questions per game (host can override)
DEFAULT_QUESTIONS_PER_GAME=10
# Max questions per game
MAX_QUESTIONS_PER_GAME=20
# Seconds per question
QUESTION_TIME_LIMIT_SECONDS=30

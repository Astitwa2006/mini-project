{
  "name": "mini-project",
  "version": "1.0.0",
  "description": "Real-Time Multiplayer Quiz Game",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "client",
    "server",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run build --workspace=client && npm start --workspace=server",
    "test": "npm run test --workspace=tests",
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server && npm install --workspace=tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
